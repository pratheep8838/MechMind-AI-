<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FactoryCopilot AI</title>
  <style>
    :root {
      --bg: #0b0f19;
      --card-bg: #111827;
      --card-border: #1f2937;
      --text: #f9fafb;
      --text-muted: #9ca3af;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --danger-bg: rgba(239, 68, 68, 0.1);
      --danger-border: rgba(239, 68, 68, 0.3);
      --danger-text: #ef4444;
      --accent: #10b981;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px 16px;
      gap: 40px;
    }

    /* Copilot Card */
    .copilot-card {
      width: 100%;
      max-width: 440px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 20px;
      border-bottom: 1px solid var(--card-border);
    }

    .card-header h2 {
      font-size: 1.1rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .settings-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1.2rem;
      color: var(--text-muted);
      transition: color 0.2s;
    }

    .settings-btn:hover {
      color: var(--text);
    }

    /* Metrics Section */
    .metrics-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      padding: 20px;
      text-align: center;
      border-bottom: 1px solid var(--card-border);
      background: rgba(255, 255, 255, 0.01);
    }

    .metric-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .metric-value {
      font-size: 1.1rem;
      font-weight: 700;
    }

    /* Priority Alert Box */
    .priority-section {
      padding: 20px;
      border-bottom: 1px solid var(--card-border);
    }

    .priority-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--danger-text);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      margin-bottom: 12px;
    }

    .issue-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .confidence-badge {
      display: inline-block;
      font-size: 0.75rem;
      color: var(--accent);
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.2);
      padding: 2px 8px;
      border-radius: 9999px;
      margin-bottom: 18px;
    }

    .actions {
      display: flex;
      gap: 10px;
    }

    .btn {
      flex: 1;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: background-color 0.2s, transform 0.1s;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-secondary {
      background: #1f2937;
      color: var(--text);
    }

    .btn-secondary:hover {
      background: #374151;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }

    .btn-primary:hover {
      background: var(--primary-hover);
    }

    /* Tab Navigation */
    .tab-bar {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      background: #0d131f;
    }

    .tab-btn {
      padding: 14px;
      border: none;
      background: none;
      color: var(--text-muted);
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: color 0.2s, background-color 0.2s;
    }

    .tab-btn:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.03);
    }

    .tab-btn:not(:last-child) {
      border-right: 1px solid var(--card-border);
    }

    /* Workflow Diagram Section */
    .flow-container {
      width: 100%;
      max-width: 520px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .node {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 10px 16px;
      font-size: 0.85rem;
      font-weight: 600;
      text-align: center;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .node-highlight {
      border-color: var(--primary);
      background: rgba(37, 99, 235, 0.1);
      color: #bfdbfe;
    }

    .node-action {
      border-color: var(--accent);
      background: rgba(16, 185, 129, 0.1);
      color: #a7f3d0;
    }

    .connector {
      width: 2px;
      height: 24px;
      background-color: #374151;
      position: relative;
    }

    .connector::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      border-left: 4px solid transparent;
      border-right: 4px solid transparent;
      border-top: 5px solid #374151;
    }

    .agent-branch {
      position: relative;
      display: flex;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      padding: 16px 0;
    }

    .agent-branch::before {
      content: '';
      position: absolute;
      top: 0;
      left: 18%;
      right: 18%;
      height: 2px;
      background: #374151;
    }

    .agent-branch::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 18%;
      right: 18%;
      height: 2px;
      background: #374151;
    }

    .agent-node-wrapper {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
    }

    .branch-drop {
      width: 2px;
      height: 16px;
      background: #374151;
      position: relative;
    }

    .branch-drop::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      border-left: 3px solid transparent;
      border-right: 3px solid transparent;
      border-top: 4px solid #374151;
    }

    .branch-gather {
      width: 2px;
      height: 16px;
      background: #374151;
    }
  </style>
</head>
<body>

  <div class="copilot-card">
    <div class="card-header">
      <h2>FactoryCopilot AI</h2>
      <button class="settings-btn" title="Settings">⚙️</button>
    </div>

    <div class="metrics-row">
      <div>
        <div class="metric-label">Production</div>
        <div class="metric-value">470 units</div>
      </div>
      <div>
        <div class="metric-label">Rejection</div>
        <div class="metric-value">8.9%</div>
      </div>
      <div>
        <div class="metric-label">Downtime</div>
        <div class="metric-value">4.5 hrs</div>
      </div>
    </div>

    <div class="priority-section">
      <div class="priority-badge">🚨 TOP PRIORITY</div>
      <h3 class="issue-title">Dimensional Variation</h3>
      <div class="confidence-badge">Confidence: High</div>
      <div class="actions">
        <button class="btn btn-secondary">View Root Cause</button>
        <button class="btn btn-primary">Action Plan</button>
      </div>
    </div>

    <div class="tab-bar">
      <button class="tab-btn">📊 Production</button>
      <button class="tab-btn">🔧 Design</button>
      <button class="tab-btn">💬 Feedback</button>
    </div>
  </div>

  <div class="flow-container">
    <div class="node">USER DATA</div>
    <div class="connector"></div>
    <div class="node node-highlight">ORCHESTRATOR AGENT</div>
    
    <div class="agent-branch">
      <div class="agent-node-wrapper">
        <div class="branch-drop"></div>
        <div class="node">Design Agent</div>
        <div class="branch-gather"></div>
      </div>
      <div class="agent-node-wrapper">
        <div class="branch-drop"></div>
        <div class="node">Production Agent</div>
        <div class="branch-gather"></div>
      </div>
      <div class="agent-node-wrapper">
        <div class="branch-drop"></div>
        <div class="node">Feedback Agent</div>
        <div class="branch-gather"></div>
      </div>
    </div>

    <div class="connector"></div>
    <div class="node node-highlight">Decision Agent</div>
    <div class="connector"></div>
    <div class="node node-action">ACTION PLAN</div>
  </div>

</body>
</html>
